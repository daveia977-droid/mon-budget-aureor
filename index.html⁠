
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101827">
<title>Mon Budget AŪREOR</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#142033;--line:#2a3b53;--text:#f4f7fb;--muted:#a7b4c7;--accent:#76e0bd}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px system-ui,-apple-system,sans-serif}
header{padding:22px 16px;background:#101a2b;border-bottom:1px solid var(--line)}
header small{color:var(--accent);letter-spacing:2px;font-weight:bold}
h1{margin:6px 0;font-size:27px}
header p{color:var(--muted);margin:0}
nav{display:flex;gap:7px;overflow:auto;padding:12px}
button{font:inherit;cursor:pointer;border:1px solid var(--line);border-radius:10px;padding:10px;background:#1a2a40;color:var(--text)}
nav button.active,.primary{background:var(--accent);color:#092219;font-weight:bold}
main{max-width:720px;margin:auto;padding:0 12px 25px}
.page{display:none}.page.active{display:block}
.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:14px;margin-bottom:12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.stat strong{display:block;font-size:21px;margin-top:6px;overflow-wrap:anywhere}
label{display:block;color:var(--muted);font-size:13px;margin:12px 0 5px}
input,select{width:100%;padding:11px;border-radius:9px;border:1px solid var(--line);background:#0b1423;color:var(--text);font:inherit}
.row{display:flex;gap:8px;align-items:center}.row input{flex:1;min-width:0}
.primary{width:100%;margin-top:12px}
.item{display:flex;gap:8px;align-items:center;border-bottom:1px solid var(--line);padding:12px 0}
.item:last-child{border:0}.item .details{flex:1;min-width:0;overflow-wrap:anywhere}
.item small,.muted,footer{color:var(--muted)}
.danger{color:#ff9aa5}.empty{color:var(--muted);padding:12px 0}
.bar{height:8px;background:#2a3b53;border-radius:10px;overflow:hidden;margin:9px 0}
.bar span{display:block;height:100%;background:var(--accent)}
.hint{font-size:12px;line-height:1.5}
.check{width:auto;min-width:18px}
footer{font-size:12px;padding:12px}
@media(min-width:600px){.grid{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<header>
<small>AŪREOR · FINANCES PERSONNELLES</small>
<h1>Mon Budget</h1>
<p>Ton quotidien, mieux organisé.</p>
</header>

<nav id="nav">
<button class="active" data-page="home">Accueil</button>
<button data-page="expenses">Dépenses</button>
<button data-page="bills">Factures</button>
<button data-page="tasks">Tâches</button>
<button data-page="backup">Sauvegarde</button>
</nav>

<main>
<section id="home" class="page active">
<div class="card row">
<div><small class="muted">Mois affiché</small><div id="monthLabel"></div></div>
<input type="month" id="month" aria-label="Choisir le mois" style="max-width:165px">
</div>
<div class="grid">
<div class="card stat"><small>Dépenses du mois</small><strong id="spent">0 €</strong></div>
<div class="card stat"><small>Budget restant</small><strong id="remaining">—</strong></div>
<div class="card stat"><small>Factures à payer</small><strong id="unpaid">0 €</strong></div>
<div class="card stat"><small>Tâches en attente</small><strong id="pending">0</strong></div>
</div>
<div class="card">
<strong>Budget mensuel</strong>
<label for="budget">Budget du mois (€)</label>
<div class="row"><input id="budget" type="number" min="0" step=".01" placeholder="Ex. 800"><button id="saveBudget">Enregistrer</button></div>
<div class="bar"><span id="progress" style="width:0"></span></div>
<small id="budgetHint" class="muted">Définis ton budget.</small>
</div>
<div class="card"><strong>Dépenses par catégorie</strong><div id="chart" class="empty">Aucune dépense ce mois-ci.</div></div>
<div class="card"><strong>Dernières dépenses</strong><div id="recent" class="empty">Aucune dépense.</div></div>
</section>

<section id="expenses" class="page">
<div class="card">
<strong>Ajouter une dépense</strong>
<form id="expenseForm">
<label for="ename">Intitulé</label><input id="ename" required maxlength="100" placeholder="Ex. Courses">
<label for="eamount">Montant (€)</label><input id="eamount" required type="number" min=".01" step=".01" inputmode="decimal">
<label for="ecat">Catégorie</label>
<select id="ecat"><option>Alimentation</option><option>Logement</option><option>Transport</option><option>Loisirs</option><option>Santé</option><option>Abonnements</option><option>Autres</option></select>
<label for="edate">Date</label><input id="edate" type="date" required>
<button class="primary">Ajouter la dépense</button>
</form>
</div>
<div class="card"><strong>Historique</strong><div id="elist"></div></div>
</section>

<section id="bills" class="page">
<div class="card">
<strong>Ajouter une facture</strong>
<form id="billForm">
<label for="bname">Intitulé</label><input id="bname" required maxlength="100" placeholder="Ex. Téléphone">
<label for="bamount">Montant (€)</label><input id="bamount" required type="number" min=".01" step=".01">
<label for="bdue">Date d'échéance</label><input id="bdue" type="date" required>
<button class="primary">Ajouter la facture</button>
</form>
</div>
<div class="card"><strong>Mes factures</strong><div id="blist"></div></div>
</section>

<section id="tasks" class="page">
<div class="card">
<strong>Ajouter une tâche</strong>
<form id="taskForm">
<label for="tname">Description</label><input id="tname" required maxlength="180" placeholder="Ex. Vérifier mon compte">
<button class="primary">Ajouter la tâche</button>
</form>
</div>
<div class="card"><strong>Ma liste</strong><div id="tlist"></div></div>
</section>

<section id="backup" class="page">
<div class="card">
<strong>Sauvegarde de mes données</strong>
<p class="hint">Les données sont enregistrées dans le navigateur de cet appareil. Elles ne se synchronisent pas automatiquement entre appareils. Exporte régulièrement une copie JSON.</p>
<button id="export" class="primary">Exporter une sauvegarde</button>
<label for="file">Choisir une sauvegarde JSON</label>
<input id="file" type="file" accept=".json,application/json">
<button id="restore" style="width:100%;margin-top:10px">Restaurer la sauvegarde</button>
<p id="msg" class="hint" role="status"></p>
</div>
<div class="card">
<strong>Réinitialisation</strong>
<button id="clear" class="danger" style="width:100%;margin-top:12px">Effacer toutes les données</button>
</div>
</section>
</main>
<footer>Mon Budget AŪREOR · Version personnelle. Évite d’y stocker des informations bancaires sensibles.</footer>

<script>
(function(){
"use strict";
const $=id=>document.getElementById(id);
const today=()=>{const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")};
const money=n=>new Intl.NumberFormat("fr-FR",{style:"currency",currency:"EUR"}).format(Number(n)||0);
const cats=["Alimentation","Logement","Transport","Loisirs","Santé","Abonnements","Autres"];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let month=today().slice(0,7);
let data={expenses:[],budgets:{},bills:[],tasks:[]};
try{
const saved=JSON.parse(localStorage.getItem("aureor-budget-v1"));
if(saved&&Array.isArray(saved.expenses)&&saved.budgets&&Array.isArray(saved.bills)&&Array.isArray(saved.tasks))data=saved;
}catch(e){}
function save(){
try{localStorage.setItem("aureor-budget-v1",JSON.stringify(data));return true}
catch(e){alert("Enregistrement impossible. Exporte une sauvegarde.");return false}
}
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
function expenseRow(x){
return '<div class="item"><div class="details"><strong>'+esc(x.label)+'</strong><br><small>'+esc(x.date)+' · '+esc(x.category)+'</small></div><strong>'+money(x.amount)+'</strong><button class="danger" data-delete-expense="'+x.id+'" aria-label="Supprimer">×</button></div>';
}
function render(){
const es=data.expenses.filter(x=>x.date&&x.date.slice(0,7)===month);
const total=es.reduce((s,x)=>s+x.amount,0),budget=Number(data.budgets[month]||0);
$("month").value=month;
$("monthLabel").textContent=new Date(month+"-01T12:00:00").toLocaleDateString("fr-FR",{month:"long",year:"numeric"});
$("spent").textContent=money(total);
$("remaining").textContent=budget?money(budget-total):"—";
$("remaining").style.color=budget&&total>budget?"#ff9aa5":"";
$("unpaid").textContent=money(data.bills.filter(x=>!x.paid).reduce((s,x)=>s+x.amount,0));
$("pending").textContent=data.tasks.filter(x=>!x.done).length;
$("budget").value=budget||"";
$("progress").style.width=(budget?Math.min(100,total/budget*100):0)+"%";
$("budgetHint").textContent=budget?(total>budget?"Budget dépassé de "+money(total-budget):"Il reste "+money(budget-total)):"Définis ton budget mensuel.";
const totals=cats.map(c=>({name:c,total:es.filter(x=>x.category===c).reduce((s,x)=>s+x.amount,0)})).filter(x=>x.total>0).sort((a,b)=>b.total-a.total);
$("chart").innerHTML=totals.length?totals.map(x=>'<p>'+esc(x.name)+' · '+money(x.total)+'<div class="bar"><span style="width:'+Math.max(2,x.total/Math.max(...totals.map(y=>y.total))*100)+'%"></span></div></p>').join(""):'<div class="empty">Aucune dépense ce mois-ci.</div>';
$("recent").innerHTML=[...es].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4).map(expenseRow).join("")||'<div class="empty">Aucune dépense.</div>';
$("elist").innerHTML=[...data.expenses].sort((a,b)=>b.date.localeCompare(a.date)).map(expenseRow).join("")||'<div class="empty">Aucune dépense enregistrée.</div>';
$("blist").innerHTML=data.bills.map(x=>'<div class="item"><input class="check" type="checkbox" data-paid="'+x.id+'" '+(x.paid?"checked":"")+' aria-label="Facture payée"><div class="details"><strong>'+esc(x.label)+'</strong><br><small>'+esc(x.due)+' · '+(x.paid?"Payée":"À payer")+'</small></div><strong>'+money(x.amount)+'</strong><button class="danger" data-delete-bill="'+x.id+'" aria-label="Supprimer">×</button></div>').join("")||'<div class="empty">Aucune facture enregistrée.</div>';
$("tlist").innerHTML=data.tasks.map(x=>'<div class="item"><input class="check" type="checkbox" data-task="'+x.id+'" '+(x.done?"checked":"")+' aria-label="Tâche terminée"><div class="details" style="'+(x.done?"text-decoration:line-through;color:#a7b4c7":"")+'">'+esc(x.text)+'</div><button class="danger" data-delete-task="'+x.id+'" aria-label="Supprimer">×</button></div>').join("")||'<div class="empty">Aucune tâche.</div>';
}
$("nav").addEventListener("click",e=>{
const b=e.target.closest("[data-page]");if(!b)return;
document.querySelectorAll("nav button").forEach(x=>x.classList.toggle("active",x===b));
document.querySelectorAll(".page").forEach(x=>x.classList.toggle("active",x.id===b.dataset.page));
});
$("month").addEventListener("change",e=>{if(e.target.value){month=e.target.value;render()}});
$("saveBudget").addEventListener("click",()=>{
const v=$("budget").value;
if(v===""||!Number.isFinite(Number(v))||Number(v)<0){alert("Saisis un budget valide.");return}
data.budgets[month]=Math.round(Number(v)*100)/100;save();render();
});
$("edate").value=today();$("bdue").value=today();
$("expenseForm").addEventListener("submit",e=>{
e.preventDefault();
const label=$("ename").value.trim(),amount=Number($("eamount").value);
if(!label||!Number.isFinite(amount)||amount<=0||!$("edate").value){alert("Vérifie le nom, le montant et la date.");return}
data.expenses.push({id:uid(),label,amount:Math.round(amount*100)/100,category:$("ecat").value,date:$("edate").value});
save();e.target.reset();$("edate").value=today();render();
});
$("billForm").addEventListener("submit",e=>{
e.preventDefault();
const label=$("bname").value.trim(),amount=Number($("bamount").value);
if(!label||!Number.isFinite(amount)||amount<=0||!$("bdue").value){alert("Vérifie le nom, le montant et l'échéance.");return}
data.bills.push({id:uid(),label,amount:Math.round(amount*100)/100,due:$("bdue").value,paid:false});
save();e.target.reset();$("bdue").value=today();render();
});
$("taskForm").addEventListener("submit",e=>{
e.preventDefault();const text=$("tname").value.trim();if(!text)return;
data.tasks.push({id:uid(),text,done:false});save();e.target.reset();render();
});
document.addEventListener("click",e=>{
const b=e.target.closest("button");if(!b)return;
if(b.dataset.deleteExpense)remove("expenses",b.dataset.deleteExpense);
if(b.dataset.deleteBill)remove("bills",b.dataset.deleteBill);
if(b.dataset.deleteTask)remove("tasks",b.dataset.deleteTask);
});
function remove(type,id){
if(!confirm("Supprimer cet élément ?"))return;
data[type]=data[type].filter(x=>x.id!==id);save();render();
}
document.addEventListener("change",e=>{
const t=e.target;
if(t.dataset.paid){const b=data.bills.find(x=>x.id===t.dataset.paid);if(b){b.paid=t.checked;save();render()}}
if(t.dataset.task){const task=data.tasks.find(x=>x.id===t.dataset.task);if(task){task.done=t.checked;save();render()}}
});
$("export").addEventListener("click",()=>{
const blob=new Blob([JSON.stringify({...data,exportedAt:new Date().toISOString()},null,2)],{type:"application/json"});
const url=URL.createObjectURL(blob),a=document.createElement("a");
a.href=url;a.download="mon-budget-aureor-sauvegarde-"+today()+".json";
document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
$("msg").textContent="Vérifie dans Fichiers que la sauvegarde a bien été téléchargée.";
});
$("restore").addEventListener("click",async()=>{
const f=$("file").files[0];if(!f){$("msg").textContent="Choisis d'abord un fichier JSON.";return}
try{
const s=JSON.parse(await f.text());
if(!s||!Array.isArray(s.expenses)||!s.budgets||!Array.isArray(s.bills)||!Array.isArray(s.tasks))throw Error();
if(!confirm("Remplacer les données actuelles par cette sauvegarde ?"))return;
data={expenses:s.expenses,budgets:s.budgets,bills:s.bills,tasks:s.tasks};save();render();$("msg").textContent="Sauvegarde restaurée.";
}catch(e){$("msg").textContent="Fichier invalide. Aucune donnée restaurée."}
});
$("clear").addEventListener("click",()=>{
if(!confirm("Effacer toutes les données ? Exporte d'abord une sauvegarde si nécessaire."))return;
data={expenses:[],budgets:{},bills:[],tasks:[]};save();render();
});
render();
})();
</script>
</body>
</html>
